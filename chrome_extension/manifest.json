{
  "manifest_version": 3,
  "name": "Smart Flow Sheet Helper",
  "version": "0.4.2",
  "description": "Smart Flow patient and flowsheet tools, including bulk schedule changes.",
  "content_scripts": [
    {
      "matches": [
        "https://www.smartflowsheet.com/*",
        "https://*.smartflowsheet.com/*",
        "file:///*"
      ],
      "js": [
        "src/value-parsers.js",
        "src/controlled-medications.js",
        "src/site-data.js",
        "src/smartflow-reader.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.smartflowsheet.com/*",
        "https://*.smartflowsheet.com/*",
        "file:///*"
      ],
      "css": [
        "src/ui.css"
      ],
      "js": [
        "src/controlled-medications.js",
        "src/content-bridge.js",
        "src/ui-layout.js",
        "src/schedule-editor.js",
        "src/schedule-panel.js",
        "src/ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
